# ============================================================
# MatrixFlow Enterprise
# Variables de entorno de ejemplo
# ============================================================

# ------------------------------------------------------------
# PostgreSQL / Supabase
# ------------------------------------------------------------

# URL de conexión a PostgreSQL.
# Reemplazar los valores de ejemplo por las credenciales
# correspondientes al entorno local o de producción.
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@HOST:5432/postgres?sslmode=require


# ------------------------------------------------------------
# Seguridad JWT
# ------------------------------------------------------------

# Clave privada utilizada por FastAPI para firmar y validar
# los tokens JWT.
#
# Nunca colocar aquí la clave real utilizada en producción.
SECRET_KEY=cambiar_esta_clave_en_produccion