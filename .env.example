# ============================================================
# MatrixFlow Enterprise
# Variables de entorno
# ============================================================

# ------------------------------------------------------------
# Aplicación
# ------------------------------------------------------------

APP_NAME=MatrixFlow Enterprise
APP_VERSION=1.0.0


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

POSTGRES_USER=matrixflow
POSTGRES_PASSWORD=matrixflow
POSTGRES_DB=matrixflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432


# ------------------------------------------------------------
# URL de conexión SQLAlchemy
# ------------------------------------------------------------

DATABASE_URL=postgresql+psycopg2://matrixflow:matrixflow@localhost:5432/matrixflow


# ------------------------------------------------------------
# Seguridad
# ------------------------------------------------------------

# Clave utilizada posteriormente para firmar los JWT.
SECRET_KEY=cambiar_esta_clave_en_produccion

# Algoritmo utilizado para JWT.
ALGORITHM=HS256

# Tiempo de expiración del token en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60